# ==========================================
# VIEWER SOCIAL - PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# Database Connection (PostgreSQL or SQLite)
# For Docker Compose (PostgreSQL):
DATABASE_URL="postgresql://user:password@postgres:5432/viewer_db?schema=public"
# For Neon / Supabase / Cloud Postgres:
# DATABASE_URL="postgresql://user:pass@ep-cool-cloud.region.aws.neon.tech/viewer?sslmode=require"
# For SQLite on VPS:
# DATABASE_URL="file:/app/data/prod.db"

# Public App URL (Your live domain name or public IP)
NEXT_PUBLIC_APP_URL="https://your-domain.com"
PORT=3000
NODE_ENV="production"

# Redis Cache / Queue (Optional - used with Docker Compose)
REDIS_URL="redis://redis:6379"

# Real-Time Messaging & Notifications (Pusher.com)
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="us2"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# Cloud Media Storage (AWS S3 or Cloudflare R2 / MinIO)
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="viewer-media"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
# Optional CDN domain (CloudFront / custom domain)
CDN_DOMAIN="https://cdn.your-domain.com"

# Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# OAuth Authentication (Optional)
GOOGLE_CLIENT_ID=""
GITHUB_CLIENT_ID=""
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""

# Cron Secret for background pre-compute tasks
CRON_SECRET="generate_a_random_32_character_string"

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
